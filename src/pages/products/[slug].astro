---
import Base from '../../layouts/Base.astro';
import BuyBox from '../../components/BuyBox.astro';
import SampleNotice from '../../components/SampleNotice.astro';
import { getCollection, render } from 'astro:content';
import { business } from '../../config/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}
const { product } = Astro.props;
const { data } = product;
const { Content } = await render(product);
// Offer markup only for real (non-sample) fixed-price products.
const jsonLd = !data.sample
  ? {
      '@context': 'https://schema.org', '@type': 'Product', name: data.title, description: data.summary, brand: { '@type': 'Brand', name: business.brand },
      ...(data.price.mode === 'fixed' ? { offers: { '@type': 'Offer', priceCurrency: 'INR', price: data.price.inrInclGst, availability: 'https://schema.org/InStock', seller: { '@type': 'Organization', name: business.legalName } } } : {}),
    }
  : undefined;
---
<Base title={data.sample ? `${data.title} (sample listing)` : data.title} description={data.summary} noindex={data.sample} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <nav class="text-sm text-slate-500" aria-label="Breadcrumb"><a href="/products/" class="hover:underline">Products</a> / <span>{data.title}</span></nav>
    {data.sample && <div class="mt-4"><SampleNotice /></div>}
    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_22rem]">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">{data.title} {data.sample && <SampleNotice compact />}</h1>
        <p class="mt-3 text-lg text-slate-600">{data.summary}</p>
        <div class="prose prose-slate mt-6 max-w-none prose-a:text-brand-700"><Content /></div>
        {data.specs.length > 0 && (
          <section class="mt-8">
            <h2 class="text-xl font-semibold text-slate-900">Key specifications</h2>
            <table class="mt-3 w-full text-left text-sm">
              <tbody>{data.specs.map((s) => <tr class="border-b border-slate-200"><th class="w-1/3 py-2 pr-4 font-medium text-slate-700">{s.k}</th><td class="py-2">{s.v}</td></tr>)}</tbody>
            </table>
          </section>
        )}
        {data.options.length > 0 && (
          <section class="mt-8">
            <h2 class="text-xl font-semibold text-slate-900">Options</h2>
            <ul class="mt-2 list-disc pl-5 text-sm">{data.options.map((o) => <li>{o}</li>)}</ul>
          </section>
        )}
        <p class="mt-8 text-sm text-slate-600">Shipping, cancellation and returns: see our <a class="text-brand-700 underline" href="/shipping-policy/">Shipping Policy</a> and <a class="text-brand-700 underline" href="/cancellation-and-refunds/">Cancellation &amp; Refunds</a>.</p>
      </div>
      <BuyBox title={data.title} price={data.price} sample={data.sample} hsn={data.hsn} leadTime={data.leadTime} />
    </div>
  </div>
</Base>
