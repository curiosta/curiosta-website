---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-sm font-semibold text-brand-700">404</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-900">We couldn't find that page.</h1>
    <p class="mt-4 text-slate-600">The old online store has moved. Browse the catalogue or send us your requirement.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/products/" class="rounded-md bg-brand-700 px-5 py-2.5 font-semibold text-white">Products</a>
      <a href="/contact/#rfq" class="rounded-md border border-brand-700 px-5 py-2.5 font-semibold text-brand-700">Request a quote</a>
    </div>
  </div>
</Base>
