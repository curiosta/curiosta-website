---
import { business, fullAddress, policyLinks, nav } from '../config/site';
const year = 2026;
---
<footer class="mt-16 border-t border-slate-200 bg-slate-50 text-sm text-slate-600">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-semibold text-slate-900">{business.brandMark}</p>
      <p class="mt-1">{business.brandMark} is a brand of <strong>{business.legalName}</strong> ({business.constitution.toLowerCase()}, proprietor {business.proprietor}).</p>
      <p class="mt-2">GSTIN: <span class="font-mono">{business.gstin}</span> ({business.gstState})</p>
      <address class="mt-2 not-italic">{fullAddress.map((l) => <span class="block">{l}</span>)}</address>
      <p class="mt-2">
        <a class="text-brand-700 hover:underline" href={`mailto:${business.email}`}>{business.email}</a>{' · '}<a class="text-brand-700 hover:underline" href={business.phoneHref}>{business.phoneDisplay}</a>{' · '}<a class="text-brand-700 hover:underline" href={business.whatsappHref} target="_blank" rel="noopener">WhatsApp</a>
      </p>
    </div>
    <nav aria-label="Site">
      <p class="font-semibold text-slate-900">Company</p>
      <ul class="mt-2 space-y-1">
        {nav.map((n) => <li><a class="hover:text-brand-700" href={n.href}>{n.label}</a></li>)}
        <li><a class="hover:text-brand-700" href="/pricing/">Pricing</a></li>
      </ul>
    </nav>
    <nav aria-label="Policies">
      <p class="font-semibold text-slate-900">Policies</p>
      <ul class="mt-2 space-y-1">
        {policyLinks.map((n) => <li><a class="hover:text-brand-700" href={n.href}>{n.label}</a></li>)}
        <li><a class="hover:text-brand-700" href="/policies/">All policies</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-slate-200">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs">© {year} {business.legalName}. All prices are in Indian Rupees (INR) and include GST unless stated otherwise.</p>
  </div>
</footer>
