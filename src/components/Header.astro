---
import { nav, business } from '../config/site';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2" aria-label={`${business.brand} home`}>
      <img src="/images/curiosta_logo.png" alt={business.brand} width="120" height="26" class="h-7 w-auto" />
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-5 text-sm font-medium">
        {nav.map((n) => (
          <li><a href={n.href} class:list={['hover:text-brand-700', path.startsWith(n.href) ? 'text-brand-700' : 'text-slate-700']} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/contact/#rfq" class="hidden rounded-md bg-brand-700 px-3 py-2 text-sm font-semibold text-white hover:bg-brand-800 sm:inline-block">Request a quote</a>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-md border border-slate-300 px-3 py-2 text-sm font-medium" aria-label="Menu">Menu</summary>
        <ul class="absolute right-0 mt-2 w-64 rounded-md border border-slate-200 bg-white p-2 text-sm shadow-lg">
          {nav.map((n) => <li><a href={n.href} class="block rounded px-3 py-2 hover:bg-slate-100">{n.label}</a></li>)}
          <li><a href="/contact/#rfq" class="mt-1 block rounded bg-brand-700 px-3 py-2 font-semibold text-white">Request a quote</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>
