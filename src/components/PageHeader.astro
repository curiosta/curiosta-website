---
interface Props { title: string; lead?: string; eyebrow?: string }
const { title, lead, eyebrow } = Astro.props;
---
<section class="border-b border-slate-200 bg-gradient-to-b from-brand-50 to-white">
  <div class="mx-auto max-w-6xl px-4 py-10">
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">{eyebrow}</p>}
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">{title}</h1>
    {lead && <p class="mt-3 max-w-3xl text-lg text-slate-600">{lead}</p>}
    <slot />
  </div>
</section>
