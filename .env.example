# Build-time variables for the static site. No secrets belong here: everything
# prefixed PUBLIC_ is embedded in the client bundle.

# RFQ endpoint. Leave EMPTY for M1: the contact form then opens the visitor's
# mail client (mailto:info@curiosta.com) with the fields pre-filled.
# Set to the RFQ Lambda URL path (e.g. /api/rfq behind CloudFront) once that
# Lambda is approved and deployed. On any error the form falls back to mailto.
PUBLIC_RFQ_ENDPOINT=

# Cloudflare Turnstile site key (public). Empty = widget not rendered.
# No Turnstile account exists yet (no signups in M1).
PUBLIC_TURNSTILE_SITE_KEY=

# Future Medusa store API (M3+). Keep empty: online checkout is disabled in M1.
PUBLIC_MEDUSA_BACKEND_URL=
PUBLIC_STORE_ENABLED=false
